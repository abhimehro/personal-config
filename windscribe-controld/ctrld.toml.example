# Control D Privacy Profile Configuration - EXAMPLE
# Enhanced privacy and ad-blocking
#
# Replace <CONTROL_D_PRIVACY_RESOLVER_ID> with your real resolver ID from
# the Control D dashboard. Do not commit the ID to version control.

[listener]
  [listener.0]
    ip = '127.0.0.1'
    port = 53

    [listener.0.policy]
      name = 'Privacy Policy - Enhanced Blocking'
      rules = [
        # Essential bypasses only
        {        'captive.apple.com' = []},
        {        'detectportal.firefox.com' = []},
        {        'neverssl.com' = []},
        {        'p.controld.com' = []},
        {        'local.adguard.org' = []}
      ]

[network]
  [network.0]
    name = 'Privacy Network'
    cidrs = ['0.0.0.0/0']

[upstream]
  [upstream.0]
    name = 'Control D Privacy Profile'
    type = 'doh'
    endpoint = 'https://dns.controld.com/<CONTROL_D_PRIVACY_RESOLVER_ID>'
    bootstrap_ip = '76.76.2.0'
    timeout = 3000

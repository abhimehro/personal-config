#!/bin/bash
# agent-term-doctor: session-start health check + postmortem log
# Usage: agent-term-doctor | --quiet | --json | --print-log
set -u
QUIET=0; JSON=0; PRINT_LOG=0
for arg in "$@"; do
  case "$arg" in
    --quiet|-q) QUIET=1 ;;
    --json) JSON=1 ;;
    --print-log) PRINT_LOG=1 ;;
    -h|--help) echo "agent-term-doctor [--quiet|--json|--print-log]"; exit 0 ;;
  esac
done
STATE_DIR="${AGENT_TERM_DOCTOR_DIR:-$HOME/.local/state/agent-term-doctor}"
mkdir -p "$STATE_DIR"
TS="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || date +%Y%m%dT%H%M%S)"
HOST="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo unknown)"
LOG="$STATE_DIR/session-${TS}-$$.log"
LATEST="$STATE_DIR/latest.log"
SUMMARY_JSON="$STATE_DIR/latest.json"
if [ "$PRINT_LOG" -eq 1 ]; then
  if [ -f "$STATE_DIR/LATEST_PATH" ]; then cat "$STATE_DIR/LATEST_PATH"; else echo "$LOG"; fi
  exit 0
fi
emit() {
  if [ "$QUIET" -eq 1 ] || [ "$JSON" -eq 1 ]; then
    printf "%s\n" "$*" >>"$LOG"
  else
    printf "%s\n" "$*" | tee -a "$LOG"
  fi
}
WARN=0; FAIL=0
pass() { emit "PASS  $*"; }
warn() { emit "WARN  $*"; WARN=$((WARN+1)); }
fail() { emit "FAIL  $*"; FAIL=$((FAIL+1)); }
{
  echo "agent-term-doctor"
  echo "utc=$TS"
  echo "host=$HOST"
  echo "pid=$$"
  echo "ppid=$PPID"
  echo "invoker_shell=${SHELL:-unset}"
  echo "pwd=$PWD"
  echo "user=${USER:-unknown}"
  echo "log=$LOG"
  echo "----"
} >"$LOG"
emit "=== agent-term-doctor ==="
emit "log: $LOG"
for cmd in agent-zsh agent-bash; do
  if command -v "$cmd" >/dev/null 2>&1; then
    pass "found $cmd -> $(command -v "$cmd")"
  else
    fail "missing $cmd on PATH"
  fi
done
LOGIN_SHELL="$(dscl . -read "/Users/${USER}" UserShell 2>/dev/null | awk "{print \$2}")"
emit "login_shell=${LOGIN_SHELL:-unknown}"
case "${LOGIN_SHELL:-}" in
  *fish*) pass "login shell is fish (expected)" ;;
  "") warn "could not read login shell" ;;
  *) warn "login shell is not fish: $LOGIN_SHELL" ;;
esac
PARENT_CMD="$(ps -p "$PPID" -o comm= 2>/dev/null | tr -d " ")"
emit "parent_comm=${PARENT_CMD:-unknown}"
case "${PARENT_CMD:-}" in
  *fish*) emit "NOTE  parent is fish; agents must invoke agent-zsh/agent-bash explicitly" ;;
  *zsh*|*bash*) emit "NOTE  parent looks POSIX ($PARENT_CMD)" ;;
esac
run_self() {
  local name="$1" out ec
  out="$STATE_DIR/${name}-selftest-$$.txt"
  if ! command -v "$name" >/dev/null 2>&1; then
    fail "$name not available for self-test"; return
  fi
  set +e
  "$name" --self-test >"$out" 2>"$out.err"
  ec=$?
  set -e
  { echo "--- $name self-test ---"; cat "$out"; } >>"$LOG" 2>/dev/null || true
  if [ -s "$out.err" ]; then echo "--- $name stderr ---" >>"$LOG"; cat "$out.err" >>"$LOG"; fi
  if [ "$ec" -ne 0 ]; then fail "$name --self-test exit $ec"; return; fi
  if grep -q "PWD=.*/dev/abhimehro" "$out" 2>/dev/null; then
    pass "$name workspace cd ok"
  elif grep -q "AGENT_WORKSPACE=.*abhimehro" "$out" 2>/dev/null; then
    warn "$name AGENT_WORKSPACE set but PWD not workspace"
  else
    fail "$name workspace markers missing"
  fi
  if grep -q "PYTHONUNBUFFERED=1" "$out" && grep -q "PAGER=cat" "$out"; then
    pass "$name unbuffered + pager hardened"
  else
    warn "$name missing PYTHONUNBUFFERED/PAGER hardening"
  fi
  if grep -q "stdout-mark" "$out"; then pass "$name stdout captured"; else fail "$name stdout missing"; fi
  if grep -q "stderr-mark" "$out.err" 2>/dev/null || grep -q "stderr-mark" "$out" 2>/dev/null; then
    pass "$name stderr emitted"
  else
    warn "$name stderr-mark not seen (tool may merge/drop stderr)"
  fi
  if [ "$name" = agent-bash ]; then
    if grep -q "bashrc=loaded" "$out"; then pass "agent-bash rc loaded on -c"; else fail "agent-bash rc not loaded on -c"; fi
  fi
}
set +e
run_self agent-zsh
run_self agent-bash
set -e
burst() {
  local name="$1" n=12 ok=0 i o
  for i in $(seq 1 "$n"); do
    o=$($name -c "printf "M-%s" $i" 2>/dev/null || true)
    [ "$o" = "M-$i" ] && ok=$((ok+1))
  done
  emit "burst $name $ok/$n"
  if [ "$ok" -eq "$n" ]; then pass "$name burst reliable"
  elif [ "$ok" -ge $((n*3/4)) ]; then warn "$name burst partial ($ok/$n)"
  else fail "$name burst unreliable ($ok/$n)"; fi
}
set +e
burst agent-zsh
burst agent-bash
set -e
if command -v agent-zsh >/dev/null 2>&1; then
  set +e
  out=$(agent-zsh -c "git -C \"$HOME/dev/abhimehro\" --no-pager log -1 --oneline" 2>/dev/null)
  ec=$?
  set -e
  if [ "$ec" -eq 0 ] && [ -n "$out" ]; then pass "git --no-pager returns output ($out)"
  else warn "git quick check failed ec=$ec"; fi
fi
if [ -t 0 ]; then emit "stdin_tty=yes"; else emit "stdin_tty=no"; fi
if [ -t 1 ]; then emit "stdout_tty=yes"; else emit "stdout_tty=no"; fi
if [ -t 2 ]; then emit "stderr_tty=yes"; else emit "stderr_tty=no"; fi
emit "----"
emit "INTERPRETATION"
emit "- PASS launchers + swallowed output later => suspect agent terminal tool/PTY, not shell rc"
emit "- Agents do NOT auto-switch from Fish; point them at agent-zsh or agent-bash"
emit "- Prefer: agent-zsh -c "..."   fallback: agent-bash -c "...""
emit "----"
emit "summary warnings=$WARN failures=$FAIL"
echo "$LOG" >"$STATE_DIR/LATEST_PATH"
cp "$LOG" "$LATEST" 2>/dev/null || cat "$LOG" >"$LATEST"
STATUS=ok; EC=0
if [ "$FAIL" -gt 0 ]; then STATUS=fail; EC=2; fi
if [ "$FAIL" -eq 0 ] && [ "$WARN" -gt 0 ]; then STATUS=warn; EC=1; fi
printf "{\"ts\":\"%s\",\"log\":\"%s\",\"warnings\":%s,\"failures\":%s,\"status\":\"%s\"}\n" \
  "$TS" "$LOG" "$WARN" "$FAIL" "$STATUS" >"$SUMMARY_JSON"
if [ "$JSON" -eq 1 ]; then cat "$SUMMARY_JSON"
elif [ "$QUIET" -eq 1 ]; then echo "$LOG"
else emit "status=$STATUS exit=$EC"; emit "latest=$LATEST"; fi
ls -1t "$STATE_DIR"/session-*.log 2>/dev/null | tail -n +31 | while read -r old; do rm -f "$old"; done
exit "$EC"

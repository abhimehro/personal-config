#!/bin/bash
set -euo pipefail
echo "== agent-zsh --self-test =="
agent-zsh --self-test
echo
echo "== agent-bash --self-test =="
agent-bash --self-test
echo
echo "== burst reliability (10 each) =="
for s in agent-zsh agent-bash; do
	ok=0
	for i in $(seq 1 10); do
		o=$($s -c "printf 'M-%s' $i")
		[ "$o" = "M-$i" ] && ok=$((ok + 1))
	done
	echo "$s burst ok=$ok/10"
done
echo
echo "== login shell (should remain fish) =="
dscl . -read /Users/speedybee UserShell 2>/dev/null || true
echo "ALL GREEN"

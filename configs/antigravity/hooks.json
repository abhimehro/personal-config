{
  "sonar-secrets": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/speedybee/.gemini/config/sonar/hooks/pretool-secrets.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "proactive-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|multi_edit_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/proactive/hooks/proactive-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

# Browserless + 1Password integration configuration template
# SECURITY: Example only — placeholders are NOT secrets. Copy to
# browserless.env (gitignored), or prefer the wrapper script
# scripts/browserless-env.sh which resolves op:// refs at runtime.
#
# Secret references (1Password, "Personal" vault):
#   BROWSERLESS_API_KEY  -> op://Personal/fbbrvhjsd3x7vetbz544uyvjoe/credential
#   OP_SERVICE_ACCOUNTS_TOKEN (Browserless 1Password integration)
#                       -> op://Personal/57z7qligy4voo7bjkk444jvfru/credential
#
# The Browserless integrationId is NOT a secret (it is a dashboard identifier
# returned by the REST API and shown in the dashboard). It is safe to commit.

# Browserless API key (from your Browserless account dashboard)
BROWSERLESS_API_KEY=op://Personal/fbbrvhjsd3x7vetbz544uyvjoe/credential

# 1Password service account token registered with Browserless (ops_...)
# Used only when (re)registering the integration via the REST API.
OP_SERVICE_ACCOUNTS_TOKEN=op://Personal/57z7qligy4voo7bjkk444jvfru/credential

# Browserless 1Password integration ID (op_int_...)
# Returned by POST /integrations/onepassword or visible in the dashboard
# (Profiles -> 1Password Service Accounts). Not secret; commit-safe.
BROWSERLESS_INTEGRATION_ID=REPLACE_WITH_YOUR_INTEGRATION_ID

# Browserless connection endpoint (production SFO region)
BROWSERLESS_ENDPOINT=production-sfo.browserless.io

# Control D Configuration
# Security Note: This file contains sensitive IDs.
# Permissions must be set to 600 (root:wheel on macOS) to prevent unauthorized access.

# Absolute path to personal-config checkout (required when controld-manager
# is installed to /usr/local/bin so it can source scripts/lib/*.sh).
# CONTROLD_REPO="/Users/YOUR_USERNAME/dev/personal-config"

# Control D Profile IDs
# Retrieve these from your Control D Dashboard (Resolvers section).
# They are typically found in the resolver URL or settings.
# Replace the placeholder strings below with your real resolver IDs.

# Privacy Profile ID
CTR_PROFILE_PRIVACY_ID="REPLACE_WITH_RESOLVER_ID"

# Gaming Profile ID
CTR_PROFILE_GAMING_ID="REPLACE_WITH_RESOLVER_ID"

# Browsing Profile ID
CTR_PROFILE_BROWSING_ID="REPLACE_WITH_RESOLVER_ID"

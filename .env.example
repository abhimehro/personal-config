# Email Security Pipeline Configuration Template
# SECURITY: Example only — placeholders are NOT secrets. Copy to .env, replace
# every REPLACE_WITH_* value, NEVER commit .env. Prefer 1Password for MCP keys
# (see docs/MCP_SECRETS_MANAGEMENT.md and mcp-configs/README.md).

# =============================================================================
# MCP SERVER API KEYS
# =============================================================================
# Required for various MCP servers. Prefer op:// refs in MCP templates; use
# these env vars only for local .env / tooling that cannot resolve op inject.

# Brave Search API - For web search functionality
BRAVE_API_KEY=REPLACE_WITH_YOUR_BRAVE_API_KEY

# Exa API - For advanced search and content extraction
EXA_API_KEY=REPLACE_WITH_YOUR_EXA_API_KEY

# Firecrawl API - For web crawling and scraping
FIRECRAWL_API_KEY=REPLACE_WITH_YOUR_FIRECRAWL_API_KEY

# Perplexity API - For AI-powered search and answers
PERPLEXITY_API_KEY=REPLACE_WITH_YOUR_PERPLEXITY_API_KEY

# Tavily API - For research and search capabilities
TAVILY_API_KEY=REPLACE_WITH_YOUR_TAVILY_API_KEY

# =============================================================================
# EMAIL SECURITY PIPELINE CONFIGURATION
# =============================================================================

# === Email Account 1: Gmail ===
GMAIL_ENABLED=true
GMAIL_EMAIL=REPLACE_WITH_YOUR_GMAIL_ADDRESS
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_APP_PASSWORD=REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD
GMAIL_FOLDERS=INBOX,Spam

# === Email Account 2: Outlook ===
# WARNING: Personal Outlook app passwords deprecated; prefer Gmail/Proton.
OUTLOOK_ENABLED=false
OUTLOOK_EMAIL=REPLACE_WITH_YOUR_OUTLOOK_ADDRESS
OUTLOOK_IMAP_SERVER=outlook.office365.com
OUTLOOK_IMAP_PORT=993
OUTLOOK_SMTP_SERVER=smtp.office365.com
OUTLOOK_SMTP_PORT=587
OUTLOOK_APP_PASSWORD=REPLACE_WITH_YOUR_OUTLOOK_APP_PASSWORD
OUTLOOK_FOLDERS=INBOX,Junk

# === Email Account 3: Proton Mail via Bridge ===
# Bridge IMAP usually on 127.0.0.1:143 (or 1143 if STARTTLS); SMTP 1025.
PROTON_ENABLED=false
PROTON_EMAIL=REPLACE_WITH_YOUR_PROTON_ADDRESS
PROTON_IMAP_SERVER=127.0.0.1
PROTON_IMAP_PORT=143
PROTON_SMTP_SERVER=127.0.0.1
PROTON_SMTP_PORT=1025
PROTON_APP_PASSWORD=REPLACE_WITH_YOUR_PROTON_BRIDGE_PASSWORD
PROTON_FOLDERS=INBOX,Spam

# === Analysis Configuration ===
SPAM_THRESHOLD=5.0
SPAM_CHECK_HEADERS=true
SPAM_CHECK_URLS=true
NLP_MODEL=distilbert-base-uncased
NLP_THRESHOLD=0.7
NLP_BATCH_SIZE=8
CHECK_SOCIAL_ENGINEERING=true
CHECK_URGENCY_MARKERS=true
CHECK_AUTHORITY_IMPERSONATION=true
CHECK_MEDIA_ATTACHMENTS=true
DEEPFAKE_DETECTION_ENABLED=true
MEDIA_ANALYSIS_TIMEOUT=60

# === Alert Configuration ===
ALERT_CONSOLE=true
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://REPLACE_WITH_YOUR_WEBHOOK_HOST/alerts
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK
THREAT_LOW=30
THREAT_MEDIUM=60
THREAT_HIGH=80

# === System Configuration ===
LOG_LEVEL=INFO
LOG_FILE=logs/email_security.log
CHECK_INTERVAL=300
MAX_EMAILS_PER_BATCH=50
RATE_LIMIT_DELAY=1
MAX_ATTACHMENT_SIZE_MB=25

# === Database (Optional) ===
DATABASE_ENABLED=false
DATABASE_PATH=data/email_analysis.db

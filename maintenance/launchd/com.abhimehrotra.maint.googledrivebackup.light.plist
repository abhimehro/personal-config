<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AUTOMATED_RUN</key>
		<string>1</string>
		<key>MAINTENANCE_HOME</key>
		<string>/Users/speedybee/Library/Maintenance</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.abhimehrotra.maint.googledrivebackup.light</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/speedybee/Library/Maintenance/bin/google_drive_backup.sh</string>
		<string>--run</string>
		<string>--light</string>
		<string>--no-delete</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/speedybee/Library/Logs/maintenance/googledrive_backup_light.err</string>
	<key>StandardOutPath</key>
	<string>/Users/speedybee/Library/Logs/maintenance/googledrive_backup_light.out</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
</dict>
</plist>

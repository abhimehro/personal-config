# =============================================================================
# MAINTENANCE SYSTEM CONFIGURATION
# macOS Sequoia + Apple Silicon Compatible
# =============================================================================

# HOME is not set by launchd; derive it before anything references it.
if [[ -z ${HOME:-} ]]; then
	HOME="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | awk "{print \$2}")"
	HOME="${HOME:-/Users/speedybee}"
	export HOME
fi

# =============================================================================
# LAUNCHD-SAFE ENVIRONMENT DEFAULTS
# =============================================================================
# launchd runs agents with a minimal environment: it does NOT set USER, LOGNAME,
# SHELL, TMPDIR, or LANG. Scripts run with `set -u`, so any unguarded reference
# to those variables aborts the shell with exit 127 ("unbound variable"), which
# launchd reports as LastExitStatus = 32512.
#
# Derive them here, once, so every script that sources this file is safe.
# Uses `id -un` rather than $USER so the value is correct even when unset.

if [[ -z ${USER:-} ]]; then
	USER="$(id -un 2>/dev/null || printf "%s" "${MAINTENANCE_USER:-speedybee}")"
	export USER
fi

if [[ -z ${LOGNAME:-} ]]; then
	LOGNAME="$USER"
	export LOGNAME
fi

if [[ -z ${SHELL:-} ]]; then
	SHELL="$(dscl . -read "/Users/${USER}" UserShell 2>/dev/null | awk "{print \$2}")"
	SHELL="${SHELL:-/bin/zsh}"
	export SHELL
fi

# TMPDIR is per-user under launchd; ask the system for the real path.
if [[ -z ${TMPDIR:-} ]]; then
	TMPDIR="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf "%s" /tmp)"
	TMPDIR="${TMPDIR%/}"
	export TMPDIR
fi

# Locale: without LANG, BSD tools emit non-UTF-8 output and date parsing varies.
if [[ -z ${LANG:-} ]]; then
	LANG=en_US.UTF-8
	export LANG
fi

# LANG=

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Dry run mode - set to 1 to prevent actual changes (testing only)
# Default only if not already set so command-line/environment overrides apply.
DRY_RUN=0

# Debug mode - set to 1 for verbose logging
DEBUG=0

# Notification settings
# auto|none
NOTIFY_MODE=auto
# SLACK_WEBHOOK_URL=  # Optional Slack webhook for notifications

# =============================================================================
# SYSTEM HEALTH THRESHOLDS
# =============================================================================

# Critical threshold (percentage)
DISK_CRIT_PCT=90
# Disk space warnings
# Warning threshold (percentage)
DISK_WARN_PCT=80
# Auto-cleanup on critical disk usage
HEALTHCHECK_AUTO_REMEDIATE=1

# Memory pressure monitoring
# Memory pressure warning threshold
MEMORY_PRESSURE_WARN=80

# Check system logs for last 24 hours
HEALTH_LOG_LOOKBACK_HOURS=24
# Log retention and system monitoring
# Keep logs for 60 days
LOG_RETENTION_DAYS=60

# =============================================================================
# CLEANUP SETTINGS
# =============================================================================

# Cache and temporary file cleanup
# Clean caches older than 30 days
CLEANUP_CACHE_DAYS=30
# Clean temp files older than 7 days
TMP_CLEAN_DAYS=7
# Keep Xcode derived data for 30 days
XCODE_DERIVEDDATA_KEEP_DAYS=30

# -----------------------------------------------------------------------------
# RECURRING BLOAT SETTINGS
# -----------------------------------------------------------------------------
# These paths regrow to multi-GB within weeks and are not covered by the
# generic ~/Library/Caches sweep. Each is a regenerable cache, never user data.
#
# Wallper regenerates lock-screen renders for every wallpaper that gets shown;
# 80+ files appeared in 7 days (1.9GB) alongside a 4.9GB wallpaper library.
# Retention is short because the app re-renders on demand.
# Retention is by COUNT, not age: Wallper rewrites the whole cache constantly,
# so every file stays recent while the directory still grows to ~2GB.
WALLPER_CACHE_KEEP_COUNT=5

# Raycast ships debug source maps for every extension command. The maps are
# never loaded at runtime and are safe to delete; Raycast does not verify them.
# 2,312 maps accounted for 2.56GB of a 3.5GB extensions directory.
RAYCAST_STRIP_SOURCEMAPS=1

# Stale agent/server data directories are only removed when the owning
# application is confirmed absent. Comma-separated list of app names to check.
ORPHAN_AGENT_APPS=Windsurf

# Homebrew cleanup settings
# Prune Homebrew cache older than 30 days
BREW_CLEAN_PRUNE_DAYS=30

# Editor cache cleanup
# Clean editor caches older than 14 days
EDITOR_CACHE_AGE_DAYS=14
# Clean if cache exceeds 2GB
EDITOR_CACHE_MAX_GB=2

# =============================================================================
# DEVELOPMENT ENVIRONMENT SETTINGS
# =============================================================================

# Repository search paths for Git and Node.js maintenance
REPO_SEARCH_PATHS="$HOME/Documents/dev $HOME/RProjects"

# Git maintenance settings
GIT_SKIP_PATTERNS="node_modules|.venv|venv|.tox|.pytest_cache"

# Age threshold for Node.js module cleanup (days)
NODE_MODULES_MAX_AGE_DAYS=90
# Node.js cleanup settings
# Clean node_modules if larger than 5GB
NODE_MODULES_MAX_GB=5

# Set to 1 to enable automatic venv cleanup
CLEAN_VENVS=0
# Python virtual environment cleanup
# Consider venvs older than 120 days for cleanup
VENV_MAX_AGE_DAYS=120
# and larger than 1GB
VENV_MAX_GB=1

# =============================================================================
# CLOUD AND NETWORK SETTINGS
# =============================================================================

# Google Cloud settings
CLOUDSDK_CORE_PROJECT=perplexity-clone-project

# Cloud logging (optional)
# Set to 1 to enable Google Cloud logging
GCLOUD_LOGGING=0
GCLOUD_LOG_NAME=maintenance

# OneDrive monitoring (deprecated)

# =============================================================================
# PACKAGE MANAGEMENT SETTINGS
# =============================================================================

# Auto-update Homebrew packages
UPDATE_HOMEBREW=1
# Auto-update Mac App Store apps
UPDATE_MAS_APPS=1
# Auto-update global Node.js packages
UPDATE_NODE_GLOBAL=1
# Control which package managers get updated
# Conservative: don't auto-update pip packages
UPDATE_PIP_USER_PKGS=0
# Auto-update Ruby gems
UPDATE_RUBY_GEMS=1

# Homebrew cask update settings
# Set to 1 to update casks with version :latest (more frequent updates)
UPDATE_GREEDY_LATEST=0

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Performance settings
# Number of parallel Git operations
GIT_MAINTENANCE_PARALLEL=2

# Create backups before major cleanups (disk space intensive)
BACKUP_BEFORE_CLEANUP=0
# Safety settings - these should generally stay enabled
# Skip Git maintenance on repos with uncommitted changes
REQUIRE_CLEAN_REPOS=1

# =============================================================================
# ENVIRONMENT OVERRIDES
# =============================================================================

# These will override system defaults if set
# HOMEBREW_NO_AUTO_UPDATE=1  # Disable Homebrew auto-update during operations
# HOMEBREW_NO_ENV_HINTS=1    # Hide Homebrew environment hints
# Google Drive monitoring
# Alert if no sync activity for 48 hours
GDRIVE_SYNC_CHECK_HOURS=48

# =============================================================================
# CLOUD DRIVE PATHS
# =============================================================================

# Google Drive for Desktop root (CloudStorage)
GDRIVE_ROOT="$HOME/Library/CloudStorage/GoogleDrive-abhimhrtr@gmail.com"

# Proton Drive root (CloudStorage)
PROTONDRIVE_ROOT="$HOME/Library/CloudStorage/ProtonDrive-abhimehro@pm.me-folder"

# Proton one-way backup destination under Proton Drive
PROTON_BACKUP_DEST="$PROTONDRIVE_ROOT/HomeBackup"
# Expected backup freshness window for ProtonDrive
PROTON_BACKUP_EXPECT_DAYS=7

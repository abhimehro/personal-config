# Google Drive Backup Exclusions (rsync)
# Security & Privacy - CRITICAL EXCLUSIONS
.ssh/id_*
.ssh/*.pem
.ssh/*_rsa
.ssh/*_dsa
.ssh/*_ed25519
.ssh/*_ecdsa
.ssh/authorized_keys
.ssh/known_hosts
.gnupg/
.aws/
.netrc
.npmrc
.config/rclone/rclone.conf
.config/gh/hosts.yml
.env
.env.*
.secrets/
*.ovpn
*.vpn
vpn.conf

# Shell History (often contains sensitive commands/tokens)
.bash_history
.zsh_history
.fish_history
.lesshst
.python_history
.mysql_history
.node_repl_history

# System & Build Artifacts (Reduce noise/size)
.DS_Store
.AppleDouble
.Trash/
.Trashes/
node_modules/
dist/
build/
coverage/
.cache/
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
.git/

# App bundles (reinstallable; not worth backing up)
# Unite Pro Apps holds 9 Electron wrappers (~266M) whose AppleDouble ._* sidecars
# are the sole source of the "Resource deadlock avoided" rsync storm. Verified
# 2026-11-16: 33,605 of 33,605 Applications errors came from this one directory.
Unite Pro Apps/

# rclone Configuration Template
# SECURITY: Placeholders below are NOT secrets. Copy to ~/.config/rclone/rclone.conf
# (chmod 600) and inject secrets via 1Password:
#   op inject -i /path/to/rclone.conf.template -o ~/.config/rclone/rclone.conf

[alldebrid]
type = webdav
url = https://webdav.debrid.it/
vendor = other
user = REPLACE_WITH_YOUR_ALLDEBRID_WEBDAV_USERNAME
pass = REPLACE_WITH_YOUR_OBSCURED_PASSWORD  # Use: rclone obscure "<password>"

[gdrive]
type = drive
client_id =
client_secret =
scope = drive
root_folder_id =
service_account_file =
token = {"access_token":"","token_type":"","refresh_token":"","expiry":""}
team_drive =

[onedrive]
type = onedrive
token = {"access_token":"","token_type":"","refresh_token":"","expiry":""}
drive_id = REPLACE_WITH_YOUR_DRIVE_ID
drive_type = personal

[media]
type = union
upstreams = gdrive:Media onedrive:Media
action_policy = epall
create_policy = epmfs
search_policy = ff

# Union Policies Explained:
# action_policy = epall (existing path, all)
# create_policy = epmfs (existing path, most free space)
# search_policy = ff (first found)

{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/run-snyk-sai.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/run-snyk-sai.sh",
        "loop_limit": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/dependency-health-reminder.sh",
        "matcher": "pip|npm|yarn|pnpm|uv |cargo|composer|poetry|gem |go get|bun "
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "/Users/speedybee/.config/deja/bin/deja-hook hook-prompt"
      },
      {
        "command": "'/Users/speedybee/.cursor/hooks/sonar-secrets/build-scripts/prompt-secrets.sh'",
        "timeout": 60,
        "failClosed": false,
        "matcher": "UserPromptSubmit"
      }
    ],
    "postToolUse": [
      {
        "command": "/Users/speedybee/.config/deja/bin/deja-hook hook-tool-after",
        "matcher": "^Shell$"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "/Users/speedybee/.config/deja/bin/deja-hook hook-tool-after",
        "matcher": "^Shell$"
      }
    ],
    "preCompact": [
      {
        "command": "/Users/speedybee/.config/deja/bin/deja-hook hook-precompact"
      }
    ],
    "preToolUse": [
      {
        "command": "/Users/speedybee/.config/deja/bin/deja-hook hook-tool",
        "matcher": "^(Shell|Write|Task)$"
      },
      {
        "command": "'/Users/speedybee/.cursor/hooks/sonar-secrets/build-scripts/pre-tool-use-secrets.sh'",
        "timeout": 60,
        "failClosed": false,
        "matcher": "Read"
      }
    ],
    "sessionEnd": [
      {
        "command": "/Users/speedybee/.config/deja/bin/deja-hook hook-session-end"
      }
    ],
    "sessionStart": [
      {
        "command": "/Users/speedybee/.config/deja/bin/deja-hook hook-context"
      }
    ],
    "beforeReadFile": [
      {
        "command": "'/Users/speedybee/.cursor/hooks/sonar-secrets/build-scripts/before-read-file-secrets.sh'",
        "timeout": 60,
        "failClosed": false,
        "matcher": "Read|TabRead"
      }
    ]
  }
}
